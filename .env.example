# Copy this file to .env (in the same folder) and fill in your values.
# Keep .env private. Never share it or put it online.

# Your site address.
# While testing on your computer use http://localhost:5173
# When the site is online use your https address, with no slash at the end.
APP_URL=http://localhost:5173

# Google sign-in: from Google Cloud Console, Credentials, your OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Review team emails, separated by commas. These accounts can approve listings.
ADMIN_EMAILS=

# Email (the thank-you email). Until SMTP_HOST is set, emails are written to the log instead of sent.
MAIL_FROM=House Hunting <hello@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
